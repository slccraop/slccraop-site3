# Environment variables for slccraop-site

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Cloudflare Turnstile
VITE_TURNSTILE_SITE_KEY=

# Base path for the site.
# Set this for GitHub Pages deployment (e.g., '/slccraop-site3/').
# Leave as '/' for Cloudflare Pages root deployment.
VITE_BASE_PATH=/