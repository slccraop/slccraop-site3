{
  "name": "slccraop-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-no-fake.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "placeholders": "node scripts/list-placeholders.mjs",
    "placeholders:md": "node scripts/list-placeholders.mjs --md",
    "placeholders:gate": "node scripts/list-placeholders.mjs --fail-if-any",
    "build:sample": "vite build --mode sample && node scripts/inline-preview.mjs",
    "check:no-fake": "node scripts/check-no-fake.mjs",
    "test:db": "vitest run --config vitest.db.config.ts"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-sinhala": "5.3.0",
    "@fontsource/noto-sans-tamil": "5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "i18next": "27.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "18.0.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "embedded-postgres": "18.6.0-beta.19",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "pg": "8.23.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
